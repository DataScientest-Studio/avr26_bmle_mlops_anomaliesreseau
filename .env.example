# db
POSTGRES_DB=eco2mix
POSTGRES_USER=eco2mix
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost   # depuis l'hôte ; les conteneurs utilisent "db"
POSTGRES_PORT=5432
MLFLOW_DB_PASSWORD=mlflow_change_me
AIRFLOW_DB_PASSWORD=airflow_change_me

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=airflow_admin_change_me

# Fusion automatique des deux fichiers compose
COMPOSE_FILE=docker-compose.yaml:docker-compose.airflow.yaml

# Générées par `make airflow-prep-env` — ne pas renseigner à la main :
# DOCKER_SOCK, AIRFLOW_UID, DOCKER_GID, AIRFLOW_FERNET_KEY
